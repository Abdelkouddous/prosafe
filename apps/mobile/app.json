{
  "expo": {
    "name": "PROSAFE",
    "slug": "prosafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prosafe",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prosafe.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.prosafe.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PROSAFE utilise votre position pour localiser précisément les incidents signalés."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PROSAFE accède à vos photos pour joindre des preuves aux incidents.",
          "cameraPermission": "PROSAFE utilise la caméra pour photographier les incidents.",
          "microphonePermission": "PROSAFE utilise le microphone pour enregistrer des notes vocales et des vidéos d'incident."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PROSAFE utilise la caméra pour photographier les incidents.",
          "microphonePermission": "PROSAFE utilise le microphone pour enregistrer des vidéos d'incident.",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
