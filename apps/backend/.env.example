# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=prosafe
POSTGRES_SSL=false

PORT=3000
NODE_ENV="development"

# RS256 JWT keys (generate with: openssl genrsa 2048 ; openssl rsa -in private.pem -pubout)
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<generate with: openssl genrsa 2048>\n-----END PRIVATE KEY-----"
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<generate with: openssl rsa -in private.pem -pubout>\n-----END PUBLIC KEY-----"

# Uploaded files (stored on disk, path kept in DB)
UPLOADS_DIR=uploads

# CORS: comma-separated list of allowed origins (empty = built-in defaults)
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the app (Railway = 1). Needed for per-client rate limiting.
TRUST_PROXY=1

# Rate limiting: max requests per minute per IP (default 100)
THROTTLE_LIMIT=100

# Email SMTP configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM="Prosafe" <no-reply@prosafelabs.local>

# Base URL used in emails for verification links
APP_BASE_URL="http://localhost:3000"
